# Copy to .env.local and fill in values.

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://tradepilot.app

# ---------- Supabase (authenticated trading app) ----------
NEXT_PUBLIC_SUPABASE_URL=https://cofqyzlhquevcefdxxke.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- SEO analytics & verification (all optional) ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_TWITTER_HANDLE=

# ---------- Market data (TwelveData) ----------
# Free plan covers XAU/USD. XAG/USD (silver) requires a paid Grow/Venture
# plan; until then silver runs on deterministic simulated data.
TWELVEDATA_API_KEY=
# Set to 1 together with a paid API key to enable live silver data.
TWELVEDATA_ENABLE_XAG=
