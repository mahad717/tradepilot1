generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// TradePilot application data.
// Authentication is handled by Supabase (auth.users); `userId` below is the
// Supabase auth UID. Signal / backtest records live in the local app database
// so the SEO public site stays fully static with zero DB dependency.
// ---------------------------------------------------------------------------

model SavedSignal {
  id         String   @id @default(cuid())
  userId     String
  email      String?
  symbol     String
  interval   String
  side       String // LONG | SHORT
  entry      Float
  stopLoss   Float
  targets    String // JSON string: number[]
  confidence Float
  grade      String // A | B | C
  rationale  String // JSON string: string[]
  status     String   @default("OPEN") // OPEN | CLOSED
  outcomeR   Float?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model BacktestRun {
  id        String   @id @default(cuid())
  userId    String
  email     String?
  symbol    String
  interval  String
  bars      Int
  fromAt    DateTime?
  toAt      DateTime?
  params    String // JSON string
  metrics   String // JSON string (metrics + equity curve summary)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
